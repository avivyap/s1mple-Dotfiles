[global]
default-profile='default'
profile-list=['default', 'profile0']

[profiles/default]
allow-bold=false
background-color='#000000000000'
background-darkness=0.91624365482233505
background-type='transparent'
bold-color='#000000000000'
cursor-shape='ibeam'
default-show-menubar=false
default-size-columns=133
default-size-rows=34
font='Hack Nerd Font Mono 22'
foreground-color='#FFFFFFFFFFFF'
palette='#2E2E34343636:#CCCC00000000:#4E4E9A9A0606:#C4C4A0A00000:#34346565A4A4:#757550507B7B:#060698209A9A:#D3D3D7D7CFCF:#555557575353:#EFEF29292929:#8A8AE2E23434:#FCFCE9E94F4F:#72729F9FCFCF:#ADAD7F7FA8A8:#3434E2E2E2E2:#EEEEEEEEECEC'
scrollback-lines=16384
scrollback-unlimited=true
scrollbar-position='right'
silent-bell=true
title='Parrot Terminal'
use-custom-default-size=false
use-system-font=false
use-theme-colors=false
visible-name='Default'

[profiles/profile0]
allow-bold=false
background-color='#000000000000'
background-darkness=0.91624365482233505
background-image=''
background-type='transparent'
backspace-binding='ascii-del'
bold-color='#000000000000'
bold-color-same-as-fg=true
copy-selection=false
cursor-blink-mode='system'
cursor-shape='ibeam'
custom-command=''
default-show-menubar=false
default-size-columns=133
default-size-rows=34
delete-binding='escape-sequence'
exit-action='close'
font='Hack Nerd Font Mono 12'
foreground-color='#FFFFFFFFFFFF'
login-shell=false
palette='#2E2E34343636:#CCCC00000000:#4E4E9A9A0606:#C4C4A0A00000:#34346565A4A4:#757550507B7B:#060698209A9A:#D3D3D7D7CFCF:#555557575353:#EFEF29292929:#8A8AE2E23434:#FCFCE9E94F4F:#72729F9FCFCF:#ADAD7F7FA8A8:#3434E2E2E2E2:#EEEEEEEEECEC'
scroll-background=true
scroll-on-keystroke=true
scroll-on-output=false
scrollback-lines=16384
scrollback-unlimited=true
scrollbar-position='right'
silent-bell=true
title='Parrot Terminal'
title-mode='replace'
use-custom-command=false
use-custom-default-size=false
use-skey=true
use-system-font=false
use-theme-colors=false
use-urls=true
visible-name='avivyap'
word-chars='-A-Za-z0-9,./?%&#:_=+@~'
